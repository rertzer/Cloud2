Vagrant.configure("2") do |config|
  config.vm.box = "generic/ubuntu2204"

  config.vm.provider "virtualbox" do |vb|
    vb.memory = "2048"
    vb.cpus = 2
  end

  # Ansible Server
  ssh_key_path = ENV["PLAYDOH_KEY"]
  config.vm.define "playdoh" do |playdoh|
    playdoh.vm.hostname = "playdoh"
    playdoh.vm.network "private_network", ip: "192.168.56.110"
	playdoh.vm.provision "file", source: "files/01-netcfg.yaml", destination: "01-netcfg.yaml"
	playdoh.vm.provision "shell", path: "tools/ubuntu_server_install.sh"
    playdoh.vm.provision "shell", path: "tools/ansible_server_install.sh" 
	playdoh.vm.provision "file", source: "../playdoh", destination: "/home/vagrant/playdoh"
	playdoh.vm.provision "file", source: ssh_key_path, destination: "/home/vagrant/.ssh/cloud_ed25519"
	playdoh.vm.provision "file", source: "files/ansible.cfg", destination: "/home/vagrant/.ansible.cfg"
	playdoh.vm.provision "file", source: "tools/pswd_generator.sh", destination: "/home/vagrant/pswd_generator.sh"
	playdoh.vm.provision "shell", inline: "chmod 755 /home/vagrant/pswd_generator.sh"
	playdoh.vm.provision "shell", inline: "chmod 600 /home/vagrant/.ssh/cloud_ed25519"
	playdoh.vm.provision "shell", inline: "'192.168.56.111 pixie.ft' >> /etc/hosts"
	playdoh.vm.provision "shell", inline: "'192.168.56.112 pete.ft' >> /etc/hosts"
  end

  # Server Worker
  config.vm.define "pixie" do |pixie|
	  pixie.vm.hostname = "pixie"
	  pixie.vm.network "private_network", ip: "192.168.56.111"
	  pixie.vm.provision "file", source: "files/01-netcfg.yaml", destination: "01-netcfg.yaml"
	  pixie.vm.provision "shell", path: "tools/ubuntu_server_install.sh"
	  pixie.vm.provision "file", source: "#{ssh_key_path}.pub", destination:"/home/vagrant/.ssh/cloud_ed25519.pub"
	  pixie.vm.provision "shell", inline: "cat /home/vagrant/.ssh/cloud_ed25519.pub >> /home/vagrant/.ssh/authorized_keys"
  end


  # Server Worker 2
=begin begin   config.vm.define "pete" do |pete|
	  pete.vm.hostname = "pete"
	  pete.vm.network "private_network", ip: "192.168.56.112"
	  pete.vm.provision "file", source: "files/01-netcfg.yaml", destination: "01-netcfg.yaml"
	  pete.vm.provision "shell", path: "tools/ubuntu_server_install.sh"
	  pete.vm.provision "file", source: "#{ssh_key_path}.pub", destination:"/home/vagrant/.ssh/cloud_ed25519.pub"
	  pete.vm.provision "shell", inline: "cat /home/vagrant/.ssh/cloud_ed25519.pub >> /home/vagrant/.ssh/authorized_keys"
  end
=end
end
